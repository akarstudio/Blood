rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == 'abrar.noceng@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'email' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower() == 'abrar.noceng@gmail.com')
      );
    }

    function hasAdminRole() {
      return isBootstrappedAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        'roleIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        (
          'super_admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds ||
          'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds
        )
      );
    }

    function hasDonorManagerRole() {
      return hasAdminRole() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        'roleIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        'donor_manager' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds
      );
    }

    function hasStaffRole() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        'roleIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        (
          'super_admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds ||
          'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds ||
          'donor_manager' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds ||
          'data_entry_operator' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds ||
          'import_export_operator' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds ||
          'viewer_auditor' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds
        )
      );
    }

    function hasAuditorRole() {
      return hasAdminRole() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        'roleIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        'viewer_auditor' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAuthorizedApprovedDonor(uid) {
      return isSignedIn() && (
        hasStaffRole() || (
          exists(/databases/$(database)/documents/donors/$(uid)) &&
          get(/databases/$(database)/documents/donors/$(uid)).data.approvalStatus == 'approved' &&
          get(/databases/$(database)/documents/donors/$(uid)).data.accountStatus == 'active'
        ) || (
          exists(/databases/$(database)/documents/users/$(uid)) &&
          get(/databases/$(database)/documents/users/$(uid)).data.accountStatus == 'active' &&
          'roleIds' in get(/databases/$(database)/documents/users/$(uid)).data &&
          ('donor' in get(/databases/$(database)/documents/users/$(uid)).data.roleIds || 'super_admin' in get(/databases/$(database)/documents/users/$(uid)).data.roleIds)
        )
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isOwner(userId) || hasStaffRole();
      allow list: if hasStaffRole();

      // Administrators and staff can create user accounts (batch user imports, donor accounts)
      // Normal users can create their own profile without self-granting privileged roles
      allow create: if hasStaffRole() || (
        isOwner(userId) && (
          isBootstrappedAdmin() || 
          request.resource.data.roleIds.hasOnly(['donor', 'general_user'])
        )
      );

      // Users can update their basic fields; staff and admins can update any user
      allow update: if hasStaffRole() || (
        isOwner(userId) && 
        request.resource.data.roleIds == resource.data.roleIds &&
        request.resource.data.accountStatus == resource.data.accountStatus
      );

      allow delete: if hasAdminRole() && !isOwner(userId) && (
        resource == null || !('email' in resource.data) || resource.data.email.lower() != 'abrar.noceng@gmail.com'
      );
    }

    // DONORS COLLECTION (Public Directory Metadata - Phone numbers omitted or masked)
    match /donors/{donorId} {
      // 1. Get single document:
      // Allow read if user is the authenticated owner, authorized staff, or if doc is approved/verified/active
      allow get: if (
        isSignedIn() && (
          donorId == request.auth.uid ||
          (resource != null && 'uid' in resource.data && resource.data.uid == request.auth.uid) ||
          hasStaffRole()
        )
      ) || (
        resource != null &&
        resource.data.approvalStatus == 'approved' &&
        resource.data.contactVerificationStatus == 'verified' &&
        resource.data.accountStatus == 'active'
      );

      // 2. List queries:
      // Match query filters statically without resource != null constraints
      allow list: if (
        isSignedIn() && hasStaffRole()
      ) || (
        isSignedIn() && resource.data.uid == request.auth.uid
      ) || (
        resource.data.approvalStatus == 'approved' &&
        resource.data.contactVerificationStatus == 'verified' &&
        resource.data.accountStatus == 'active'
      );

      // 3. Creation:
      // Registered authenticated user creating their own donor profile with pending status
      // Or authorized staff (donor_manager, admin, super_admin, data_entry_operator, etc.)
      allow create: if isSignedIn() && (
        hasStaffRole() || (
          (request.resource.data.uid == request.auth.uid || donorId == request.auth.uid) &&
          request.resource.data.approvalStatus == 'pending' &&
          request.resource.data.contactVerificationStatus == 'unverified' &&
          request.resource.data.accountStatus == 'active'
        )
      );

      // 4. Update:
      // Authorized staff can update all fields
      // Donor owners can update declaredAvailability, contact preferences, and notes,
      // but strictly NOT approvalStatus, contactVerificationStatus, or accountStatus
      allow update: if hasStaffRole() || (
        isSignedIn() &&
        (donorId == request.auth.uid || (resource != null && 'uid' in resource.data && resource.data.uid == request.auth.uid)) &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.contactVerificationStatus == resource.data.contactVerificationStatus &&
        request.resource.data.accountStatus == resource.data.accountStatus
      );

      // 5. Delete:
      // Admins and donor managers can delete donors.
      // Registered donors can delete their own donor profile (Right to be Forgotten).
      allow delete: if hasAdminRole() || hasDonorManagerRole() || (
        isSignedIn() && (
          donorId == request.auth.uid ||
          (resource != null && 'uid' in resource.data && resource.data.uid == request.auth.uid)
        )
      );
    }

    // DONOR CONTACTS COLLECTION (Strict Phone Number Access Protection)
    // Only authenticated users with an approved active donor profile or staff can view phone numbers
    match /donorContacts/{donorId} {
      allow get: if isSignedIn() && (
        hasStaffRole() ||
        donorId == request.auth.uid ||
        (resource != null && 'donorId' in resource.data && resource.data.donorId == request.auth.uid) ||
        isAuthorizedApprovedDonor(request.auth.uid)
      );
      allow list: if isSignedIn() && hasStaffRole();
      allow create, update: if isSignedIn() && (
        hasStaffRole() ||
        donorId == request.auth.uid ||
        request.resource.data.donorId == request.auth.uid
      );
      allow delete: if hasAdminRole() || hasDonorManagerRole() || (
        isSignedIn() && (
          donorId == request.auth.uid ||
          (resource != null && 'donorId' in resource.data && resource.data.donorId == request.auth.uid)
        )
      );
    }

    // REGISTERED PHONES LOOKUP (to prevent duplicates without scanning private donor records)
    match /registeredPhones/{phone} {
      allow get: if isSignedIn();
      allow list: if hasStaffRole();
      allow create, update: if isSignedIn() && (
        hasStaffRole() ||
        request.resource.data.uid == request.auth.uid
      );
      allow delete: if hasStaffRole() || (
        isSignedIn() && resource != null && resource.data.uid == request.auth.uid
      );
    }

    // REGISTERED IDENTIFIERS LOOKUP (Firebase Authentication Email Identifiers)
    match /registeredIdentifiers/{identifier} {
      allow get: if true;
      allow list: if hasStaffRole();
      allow create, update: if isSignedIn() && (
        hasStaffRole() ||
        request.resource.data.uid == request.auth.uid ||
        ('email' in request.auth.token && request.resource.data.email.lower() == request.auth.token.email.lower())
      );
      allow delete: if hasStaffRole() || (
        isSignedIn() && resource != null && resource.data.uid == request.auth.uid
      );
    }

    // SYSTEM SETTINGS
    match /systemSettings/availabilityPolicy {
      allow read: if true;
      allow write: if hasAdminRole();
    }

    match /systemSettings/siteConfiguration {
      allow read: if true;
      allow write: if hasAdminRole();
    }

    // ROLES COLLECTION
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if hasAdminRole();
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if hasStaffRole() || hasAuditorRole();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit logs
    }

    // IMPORT JOBS
    match /importJobs/{jobId} {
      allow read, write: if hasStaffRole();
    }
  }
}
